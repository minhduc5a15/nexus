{
  "schema_version": 1,
  "purpose": "Deterministic multi-turn runtime evaluation with scripted model proposals.",
  "cases": [
    {
      "id": "clarify_create_then_list",
      "category": "continuation",
      "initial_tasks": [],
      "turns": [
        {
          "prompt": "Thêm việc",
          "expected": {
            "state_before": "idle",
            "state_after": "awaiting_create_content",
            "status": "needs_clarification",
            "model_called": false,
            "executed_calls": [],
            "created_tasks": [],
            "tasks": [],
            "reply_contains": ["Bạn muốn thêm việc gì?"]
          }
        },
        {
          "prompt": "mua sữa",
          "expected": {
            "state_before": "awaiting_create_content",
            "state_after": "idle",
            "status": "executed",
            "model_called": false,
            "executed_calls": [
              {"name": "create_task", "arguments": {"content": "mua sữa"}}
            ],
            "created_tasks": ["mua sữa"],
            "tasks": ["mua sữa"],
            "reply_contains": ["Đã thêm [1] mua sữa"]
          }
        },
        {
          "prompt": "Xem danh sách",
          "model": {"calls": [{"name": "list_tasks", "arguments": {}}]},
          "expected": {
            "state_before": "idle",
            "state_after": "idle",
            "status": "executed",
            "model_called": true,
            "executed_calls": [
              {"name": "list_tasks", "arguments": {}}
            ],
            "created_tasks": [],
            "tasks": ["mua sữa"],
            "reply_contains": ["Danh sách hiện có 1 việc", "[1] [ ] mua sữa"]
          }
        }
      ],
      "expected_final_tasks": ["mua sữa"]
    },
